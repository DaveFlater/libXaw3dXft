#ifndef _Xaw3d_h
#define _Xaw3d_h

/*
  Internationalization and XPM support are now permanently enabled.  Define
  the macros for applications that may look for them, but they do not affect
  the build of libXaw3dXft.
*/
#define XAW_INTERNATIONALIZATION 1
#define XAW_MULTIPLANE_PIXMAPS 1

/*
  --enable-arrow-scrollbars
  Does just what it says.
*/
@MACRO_ARROW_SCROLLBARS@

/*
  --enable-gray-stipples
  Allocate a gray colorcell and use it in stippled shadows when 1) widgets
  have black or white backgrounds and 2) the beNiceToColormap resource is
  true and 3) the display allows it.
*/
@MACRO_GRAY_BLKWHT_STIPPLES@

/*
  Use static_assert(Got_XAW_defines) to verify that the configuration was
  loaded.
*/
#define Got_XAW_defines 1

#endif	/* _Xaw3d_h */
